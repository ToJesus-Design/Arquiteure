# Base de dados
DATABASE_URL="postgresql://arquiteure:arquiteure@localhost:5432/arquiteure"

# IA – Arquitetura / Visão
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL_PRIMARY="claude-opus-4-6"
ANTHROPIC_MODEL_FAST="claude-haiku-4-5-20251001"
OPENAI_API_KEY="sk-..." # Para Whisper STT

# IA Gratuita – Consultor ISO (escolher UMA das opções abaixo)
#
# Opção A — Ollama via Docker (recomendada, sem conta, sem API key):
#   docker-compose up ollama ollama-init   ← puxa o modelo automaticamente
OLLAMA_BASE_URL="http://localhost:11434/v1"   # em Docker usar http://ollama:11434/v1
OLLAMA_MODEL="llama3.1:8b"
#
# Opção A2 — Ollama local sem Docker:
#   bash scripts/setup-ollama.sh
#
# Opção B — Groq (cloud, tier gratuito, requer registo em console.groq.com):
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.3-70b-versatile"

# Storage
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="arquiteure"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Web
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Updater
KNOWLEDGE_UPDATE_CRON="0 4 * * *"
